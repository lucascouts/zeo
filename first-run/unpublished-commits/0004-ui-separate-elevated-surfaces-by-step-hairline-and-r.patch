--- a/crates/ui/src/styles/elevation.rs
+++ b/crates/ui/src/styles/elevation.rs
@@ -3,13 +3,34 @@ use std::fmt::{self, Display, Formatter};
 use gpui::{App, BoxShadow, Hsla, hsla, px};
 use theme::{ActiveTheme, Appearance};
 
-/// Today, elevation is primarily used to add shadows to elements, and set the correct background for elements like buttons.
-///
 /// Elevation can be thought of as the physical closeness of an element to the
 /// user. Elements with lower elevations are physically further away on the
 /// z-axis and appear to be underneath elements with higher elevations.
 ///
-/// In the future, a more complete approach to elevation may be added.
+/// Levels are separated by a **background step and a hairline border first**, and
+/// only then by a shadow: depth lives at a 1px scale, not in a large soft wash.
+///
+/// | Level | Variants                          | Border   | Shadow | Rim  |
+/// |-------|-----------------------------------|----------|--------|------|
+/// | `e0`  | [`Background`], [`EditorSurface`]  | none     | none   | none |
+/// | `e1`  | [`Surface`]                       | hairline | none   | none |
+/// | `e2`  | [`ElevatedSurface`]               | hairline | yes    | yes  |
+/// | `e3`  | [`ModalSurface`]                  | yes      | yes    | yes  |
+///
+/// Only `e2` and `e3` actually float, so they are the only levels that carry a
+/// drop shadow — and each also carries an inset rim of light on its top edge (see
+/// [`ElevationIndex::rim`]). On a dark canvas a black drop shadow is nearly
+/// invisible, so it is the rim, not the shadow, that sells the elevation.
+///
+/// The empty shadow stack on the grounded levels is deliberate, not an oversight:
+/// their separation comes from the background step and the hairline. Adding a
+/// shadow there produces exactly the flat, muddy look this model exists to avoid.
+///
+/// [`Background`]: ElevationIndex::Background
+/// [`EditorSurface`]: ElevationIndex::EditorSurface
+/// [`Surface`]: ElevationIndex::Surface
+/// [`ElevatedSurface`]: ElevationIndex::ElevatedSurface
+/// [`ModalSurface`]: ElevationIndex::ModalSurface
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub enum ElevationIndex {
     /// On the layer of the app background. This is under panels, panes, and
@@ -80,14 +101,41 @@ impl ElevationIndex {
         }
     }
 
+    /// Returns the inset rim of light for the levels that float, and `None` for the
+    /// levels that do not.
+    ///
+    /// A raised surface catches the light on its top edge. That highlight is what
+    /// actually reads as elevation on a dark canvas, which swallows a black drop
+    /// shadow almost entirely — so `e2` and `e3` are rimmed as well as shadowed,
+    /// and the rim carries the greater part of the effect.
+    ///
+    /// GPUI cannot colour a single border side, so the rim is expressed as an inset
+    /// [`BoxShadow`]: a 1px, zero-blur, top-edge highlight painted inside the
+    /// element's bounds. Blurring it would turn a rim into a glow.
+    ///
+    /// The rim is the same white in both appearances. Taking its colour from the
+    /// theme would invert it on a light theme — a shade, not a highlight — and a
+    /// rim that is not lighter than the surface it sits on is not a rim.
+    pub fn rim(self, _cx: &App) -> Option<BoxShadow> {
+        let alpha = match self {
+            ElevationIndex::ElevatedSurface => 0.05,
+            ElevationIndex::ModalSurface => 0.06,
+            ElevationIndex::Background
+            | ElevationIndex::Surface
+            | ElevationIndex::EditorSurface => return None,
+        };
+
+        Some(BoxShadow::new(px(0.), px(1.), hsla(0., 0., 1., alpha)).inset())
+    }
+
     /// Returns the background color for the given elevation index.
-    pub fn bg(&self, cx: &mut App) -> Hsla {
+    pub fn bg(&self, cx: &App) -> Hsla {
         match self {
             ElevationIndex::Background => cx.theme().colors().background,
             ElevationIndex::Surface => cx.theme().colors().surface_background,
             ElevationIndex::EditorSurface => cx.theme().colors().editor_background,
             ElevationIndex::ElevatedSurface => cx.theme().colors().elevated_surface_background,
-            ElevationIndex::ModalSurface => cx.theme().colors().elevated_surface_background,
+            ElevationIndex::ModalSurface => cx.theme().colors().modal_surface_background,
         }
     }
 
