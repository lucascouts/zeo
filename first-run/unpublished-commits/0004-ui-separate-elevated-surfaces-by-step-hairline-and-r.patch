+/// The Zeo radius step a surface takes at each elevation.
+///
+/// A container is promoted one step above the controls it holds (design.md
+/// §Radius), so that the surface always reads as the outermost shape: panels and
+/// popovers land on `lg`, and a modal — the command palette included — on `xl`.
+/// The grounded levels are full-bleed and take no radius at all.
+///
+/// This is the *only* place the dependent surfaces get their radius from. Pickers,
+/// the command palette and the notification toasts set no `.rounded_*()` of their
+/// own — they inherit it from here, which is why converting these two helpers
+/// re-skins all of them without a call site being touched (R2.6).
+fn radius(index: ElevationIndex) -> ZeoRadius {
+    match index {
+        ElevationIndex::Background | ElevationIndex::EditorSurface => ZeoRadius::None,
+        ElevationIndex::Surface | ElevationIndex::ElevatedSurface => ZeoRadius::Lg,
+        ElevationIndex::ModalSurface => ZeoRadius::Xl,
+    }
+}
+
+/// This level's drop shadows and its inset rim, as the single stack GPUI expects:
+/// `box_shadow` carries both kinds, and the paint pass splits them on
+/// [`BoxShadow::inset`] (`gpui/src/window.rs:3676,3712`).
+///
+/// The rim is appended rather than prepended only to keep the drop shadows in the
+/// order [`ElevationIndex::shadow`] defines them; across the inset boundary the
+/// order carries no meaning. On the grounded levels both halves are empty, which is
+/// what leaves `elevation_1` with no shadow of any kind.
+fn shadows_and_rim(index: ElevationIndex, cx: &App) -> Vec<BoxShadow> {
+    let mut stack = index.shadow(cx);
+    stack.extend(index.rim(cx));
+    stack
+}
 
