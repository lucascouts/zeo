+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use settings_macros::{MergeFrom, with_fallible_options};
+
+/// The `zeo` namespace: user-facing knobs for the Zeo visual identity.
+///
+/// Every Zeo design token resolves its value from this group through
+/// `theme::ThemeSettingsProvider`, so a token is never a compile-time constant
+/// and a change here reaches open windows without a restart.
+#[with_fallible_options]
+#[derive(Clone, PartialEq, Default, Serialize, Deserialize, JsonSchema, MergeFrom, Debug)]
+pub struct ZeoSettingsContent {
+    /// A multiplier applied to every step of the Zeo radius scale.
+    ///
+    /// The range below only annotates the JSON schema, so an editor can hint the
+    /// bounds; it rejects nothing. Enforcement is `theme_settings`'
+    /// `clamp_radius_scale`, which clamps on every read — a typo can therefore
+    /// neither square every corner in the app (`0`) nor blow a radius up into a
+    /// rendering pathology (`1000`), and never costs the user their whole
+    /// settings file. The bounds are repeated as literals because this crate sits
+    /// *below* `theme_settings` in the dependency graph and cannot import them.
+    ///
+    /// Default: 1.0
+    #[schemars(range(min = 0.5, max = 2.0))]
+    pub radius_scale: Option<f32>,
+}
