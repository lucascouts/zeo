+    /// R2.3. `modal_surface_background` is new, so every theme that exists leaves it unset and
+    /// falls through to these base defaults. They must therefore land on exactly the elevated
+    /// surface: a `modal_surface_background` that defaults to anything else — least of all a
+    /// zeroed `Hsla`, which is transparent black — repaints every modal in every Zed theme.
+    #[test]
+    fn the_modal_surface_defaults_to_the_elevated_surface() {
+        for colors in [
+            ThemeColors::light(),
+            ThemeColors::dark(),
+            crate::fallback_themes::zed_default_dark().colors().clone(),
+        ] {
+            assert_eq!(
+                colors.modal_surface_background, colors.elevated_surface_background,
+                "the modal surface must default to the elevated surface"
+            );
+            assert_ne!(colors.modal_surface_background, gpui::hsla(0., 0., 0., 0.));
+        }
+    }
