+    fn refinement_of(colors: &ThemeColorsContent) -> theme::ThemeColorsRefinement {
+        theme_colors_refinement(
+            colors,
+            &status_colors_refinement(&StatusColorsContent::default()),
+            false,
+        )
+    }
+
+    #[test]
+    fn modal_surface_background_falls_back_to_elevated_surface_background() {
+        let refinement = refinement_of(&ThemeColorsContent {
+            elevated_surface_background: Some("#ff00ff".to_string()),
+            ..Default::default()
+        });
+
+        assert_eq!(
+            refinement.modal_surface_background,
+            Some(parse_color("#ff00ff"))
+        );
+        assert_eq!(
+            refinement.modal_surface_background,
+            refinement.elevated_surface_background
+        );
+    }
+
+    #[test]
+    fn explicit_modal_surface_background_takes_precedence_over_the_fallback() {
+        let refinement = refinement_of(&ThemeColorsContent {
+            elevated_surface_background: Some("#ff00ff".to_string()),
+            modal_surface_background: Some("#00ff00".to_string()),
+            ..Default::default()
+        });
+
+        assert_eq!(
+            refinement.modal_surface_background,
+            Some(parse_color("#00ff00"))
+        );
+        assert_eq!(
+            refinement.elevated_surface_background,
+            Some(parse_color("#ff00ff"))
+        );
+    }
+
+    /// R2.3. No theme in existence sets `modal_surface.background` — it did not exist until now
+    /// — so this is the path every shipped and user-installed theme takes. The colour the
+    /// renderer ends up reading must be that theme's *own* elevated surface: not the base
+    /// theme's, and above all not a defaulted `Hsla`, which is transparent black and would put
+    /// a black modal in front of every Zed user.
+    #[test]
+    fn a_theme_without_modal_surface_background_resolves_it_to_its_own_elevated_surface() {
+        let content = ThemeColorsContent {
+            elevated_surface_background: Some("#ff00ff".to_string()),
+            ..Default::default()
+        };
+
+        for mut colors in [ThemeColors::light(), ThemeColors::dark()] {
+            let base_elevated = colors.elevated_surface_background;
+            colors.refine(&refinement_of(&content));
+
+            assert_eq!(colors.elevated_surface_background, parse_color("#ff00ff"));
+            assert_eq!(
+                colors.modal_surface_background, colors.elevated_surface_background,
+                "an unset modal surface must resolve to the theme's own elevated surface"
+            );
+            assert_ne!(
+                colors.modal_surface_background, base_elevated,
+                "the fallback must follow the theme, not the base defaults"
+            );
+            assert_ne!(
+                colors.modal_surface_background,
+                gpui::hsla(0., 0., 0., 0.),
+                "a defaulted Hsla here is a black modal in every existing theme"
+            );
+        }
+    }
+
+    /// A theme that sets neither colour keeps whatever the base defaults say, so those two
+    /// defaults have to agree — otherwise such a theme's modals shift.
+    #[test]
+    fn a_theme_that_sets_neither_surface_keeps_the_base_defaults_in_agreement() {
+        for mut colors in [ThemeColors::light(), ThemeColors::dark()] {
+            colors.refine(&refinement_of(&ThemeColorsContent::default()));
+
+            assert_eq!(
+                colors.modal_surface_background,
+                colors.elevated_surface_background
+            );
+        }
+    }
+
+    #[test]
+    fn modal_surface_background_deserializes_from_its_theme_json_key() {
+        let content: ThemeColorsContent = serde_json::from_value(serde_json::json!({
+            "modal_surface.background": "#00ff00",
+        }))
+        .expect("theme colors content should deserialize");
+
+        assert_eq!(content.modal_surface_background.as_deref(), Some("#00ff00"));
+    }
+
