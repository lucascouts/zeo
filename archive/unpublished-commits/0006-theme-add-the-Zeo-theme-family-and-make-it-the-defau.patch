@@ -0,0 +1,419 @@
+//! Integration tests for the Zeo theme family (story 002, sub-tasks 5.1 and 5.2 —
+//! R2.1 (data half), R3.2, R3.3, R3.4, R3.5, R3.6, R3.7).
+//!
+//! ## Materialisation (executor — do this BEFORE authoring `zeo.json`)
+//!
+//! 1. Copy this file to `fork/crates/theme_settings/tests/zeo_theme.rs`.
+//!    It is an external test target: cargo discovers `tests/*.rs` automatically,
+//!    so there is no `mod` line to add anywhere.
+//! 2. Add one dev-dependency to `fork/crates/theme_settings/Cargo.toml`:
+//!
+//!        [dev-dependencies]
+//!        assets.workspace = true
+//!
+//!    It is needed because `theme_registration_requires_no_code` loads the themes
+//!    through the REAL asset embedder (`crates/assets/src/assets.rs:7-13`), which
+//!    is the mechanism D10 claims makes the theme zero-code. A test that inserted
+//!    the theme into the registry by hand would prove nothing about that claim,
+//!    and would still pass if `zeo.json` were dropped in the wrong directory.
+//! 3. Run: `cd fork && cargo test -p theme_settings --test zeo_theme`
+//!    (`cd fork` is mandatory — see `docs/BUILD.md:26-31`.)
+//!
+//! ## Expected Red (confirm this BEFORE implementing — do not skip)
+//!
+//! An assertion failure at the very first step, not a compile error — everything
+//! this file imports already exists:
+//!
+//!     panicked at 'assets/themes/zeo/zeo.json does not exist yet
+//!     (No such file or directory)'
+//!
+//! That is the right failure: the theme has not been authored. After `zeo.json`
+//! lands but before `default.json` is flipped (5.2), `default_json_theme_names_
+//! match_the_theme_family` fails instead, with `"One Dark" != "Zeo Dark"` — also
+//! valid Red, and the exact failure that stands between Zeo and shipping a build
+//! that silently renders as Zed.
+//!
+//! ## Why this file carries R2.1
+//!
+//! `ElevationIndex::bg()` reads `elevated_surface_background` from the *active
+//! theme* (`crates/ui/src/styles/elevation.rs:89-90`). The "elevated surface has
+//! no background step" defect is therefore a **data** defect (`one.json:16-17`
+//! dark, `:430-431` light), and no unit test in `crates/ui` can assert its fix —
+//! a `ui` test runs against One Dark, where the defect is still present by design.
+//! The luminance step is asserted HERE, against the Zeo palette, or nowhere.
+
+use std::path::{Path, PathBuf};
+
+use gpui::{Rgba, TestAppContext};
+use settings::SettingsStore;
+use theme::{AppearanceContent, ThemeRegistry};
+use theme_settings::{ThemeContent, ThemeFamilyContent};
+
+/// WCAG 2.x AA for normal text (D20's contrast floor).
+const AA_CONTRAST: f32 = 4.5;
+
+/// Amethyst (D13). Two hexes, one per mode: a single hex cannot serve both — the
+/// maths in design.md §Accent rules it out.
+const ACCENT_DARK: &str = "#BD93F9";
+const ACCENT_LIGHT: &str = "#7C3AED";
+
+/// A "step" that a human eye can actually see. Zed's dead step is +0.2% relative
+/// luminance (`#2e343e` -> `#2f343e`); anything of that order is the defect, not
+/// a fix.
+const MIN_LUMINANCE_STEP: f32 = 0.01;
+
+fn repo_asset(relative: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../assets")
+        .join(relative)
+}
+
+fn read_asset(relative: &str) -> Vec<u8> {
+    let path = repo_asset(relative);
+    match std::fs::read(&path) {
+        Ok(bytes) => bytes,
+        Err(error) => panic!("{relative} does not exist yet ({error})"),
+    }
+}
+
+fn zeo_family() -> ThemeFamilyContent {
+    let bytes = read_asset("themes/zeo/zeo.json");
+    match theme_settings::deserialize_user_theme(&bytes) {
+        Ok(family) => family,
+        Err(error) => panic!(
+            "assets/themes/zeo/zeo.json must deserialise into ThemeFamilyContent \
+             (this is the same parse the app performs at startup, and it fails \
+             SILENTLY there — it only logs): {error}"
+        ),
+    }
+}
+
+fn variant<'a>(family: &'a ThemeFamilyContent, name: &str) -> &'a ThemeContent {
+    match family.themes.iter().find(|theme| theme.name == name) {
+        Some(theme) => theme,
+        None => panic!(
+            "the Zeo family must contain the variant {name:?}; it contains {:?}",
+            family
+                .themes
+                .iter()
+                .map(|theme| theme.name.as_str())
+                .collect::<Vec<_>>()
+        ),
+    }
+}
+
+fn color(label: &str, value: &Option<String>) -> Rgba {
+    let Some(value) = value else {
+        panic!("{label} is not set in the Zeo palette");
+    };
+    match Rgba::try_from(value.as_str()) {
+        Ok(rgba) => rgba,
+        Err(error) => panic!("{label} is not a parseable colour ({value:?}): {error}"),
+    }
+}
+
+/// WCAG relative luminance (sRGB), computed straight from the theme JSON — no
+/// rendering needed, which is why the contrast floor can be a cheap test rather
+/// than an eyeball on a screenshot.
+fn relative_luminance(color: Rgba) -> f32 {
+    fn linearize(channel: f32) -> f32 {
+        if channel <= 0.03928 {
+            channel / 12.92
+        } else {
+            ((channel + 0.055) / 1.055).powf(2.4)
+        }
+    }
+
+    0.2126 * linearize(color.r) + 0.7152 * linearize(color.g) + 0.0722 * linearize(color.b)
+}
+
+fn contrast_ratio(foreground: Rgba, background: Rgba) -> f32 {
+    let (a, b) = (
+        relative_luminance(foreground),
+        relative_luminance(background),
+    );
+    let (lighter, darker) = if a >= b { (a, b) } else { (b, a) };
+    (lighter + 0.05) / (darker + 0.05)
+}
+
+fn same_color(a: Rgba, b: Rgba) -> bool {
+    let close = |x: f32, y: f32| (x - y).abs() < 1. / 512.;
+    close(a.r, b.r) && close(a.g, b.g) && close(a.b, b.b) && close(a.a, b.a)
+}
+
+// --- Parse and registration (R3.2) -------------------------------------------
+
+#[test]
+fn zeo_json_deserialises_and_declares_both_variants() {
+    let family = zeo_family();
+
+    assert_eq!(family.name, "Zeo", "the family name is the Zeo brand");
+
+    let dark = variant(&family, "Zeo Dark");
+    let light = variant(&family, "Zeo Light");
+
+    assert_eq!(dark.appearance, AppearanceContent::Dark);
+    assert_eq!(light.appearance, AppearanceContent::Light);
+    assert_eq!(
+        family.themes.len(),
+        2,
+        "the family ships exactly the two variants the default theme block names"
+    );
+}
+
+/// D10: themes are embedded by directory glob and discovered by listing, so the
+/// theme is zero-code — but only if the file sits where the glob looks. This test
+/// goes through the real embedder, so a `zeo.json` in the wrong directory fails
+/// here instead of at a user's first launch.
+#[gpui::test]
+fn both_variants_register_with_no_code_change(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let settings_store = SettingsStore::test(cx);
+        cx.set_global(settings_store);
+        theme_settings::init(theme::LoadThemes::All(Box::new(assets::Assets)), cx);
+    });
+
+    cx.update(|cx| {
+        let registry = ThemeRegistry::default_global(cx);
+
+        for name in ["Zeo Dark", "Zeo Light"] {
+            assert!(
+                registry.get(name).is_ok(),
+                "{name} must be discoverable in the ThemeRegistry after bundled-theme \
+                 loading — if it is not, the app falls back to One Dark and only LOGS \
+                 (theme_settings.rs:171-181)"
+            );
+        }
+
+        // R3.7 — expand, don't replace. Nothing Zed shipped is removed.
+        for name in ["One Dark", "One Light"] {
+            assert!(
+                registry.get(name).is_ok(),
+                "{name} must remain selectable — story 002 adds a theme, it does not \
+                 remove any (R3.7)"
+            );
+        }
+    });
+}
+
+// --- The two research defects (R3.3, R3.4, R2.1) ------------------------------
+
+/// Finding 1: today Zeo's accent IS Zed's `info` colour — `text.accent` and `info`
+/// are byte-identical in both modes (`one.json:34`=`:128`, `:448`=`:540`). The
+/// accent has no independent identity. Without this test, a future edit can
+/// silently regress it.
+#[test]
+fn text_accent_is_distinct_from_info_in_both_variants() {
+    let family = zeo_family();
+
+    for (name, expected_hex) in [("Zeo Dark", ACCENT_DARK), ("Zeo Light", ACCENT_LIGHT)] {
+        let style = &variant(&family, name).style;
+
+        let accent = color(&format!("{name}: text.accent"), &style.colors.text_accent);
+        let info = color(&format!("{name}: info"), &style.status.info);
+
+        assert!(
+            !same_color(accent, info),
+            "{name}: text.accent must NOT be the `info` colour (D13, R3.3). This is \
+             research finding 1 — the defect this story exists to fix — and it is \
+             invisible to every other test."
+        );
+
+        let expected = match Rgba::try_from(expected_hex) {
+            Ok(rgba) => rgba,
+            Err(error) => panic!("bad expectation in the test itself: {error}"),
+        };
+        assert!(
+            same_color(accent, expected),
+            "{name}: text.accent must be Amethyst {expected_hex} (D13) — the hue was \
+             chosen for AA contrast in both modes AND for hue separation from the \
+             error/warning/success/info bands the editor already needs"
+        );
+    }
+}
+
+/// Finding 2, and the mechanical cause of the flat look: an "elevated" surface
+/// gets NO background step at all (`one.json:16-17` dark, `:430-431` light),
+/// leaving a black drop shadow as its only cue — which a dark canvas swallows.
+///
+/// This is R2.1's data half, and this test is the ONLY place it can live.
+#[test]
+fn elevated_surface_is_a_real_luminance_step_above_surface_in_both_variants() {
+    let family = zeo_family();
+
+    for name in ["Zeo Dark", "Zeo Light"] {
+        let style = &variant(&family, name).style;
+
+        let background = color(
+            &format!("{name}: background"),
+            &style.colors.background,
+        );
+        let surface = color(
+            &format!("{name}: surface.background"),
+            &style.colors.surface_background,
+        );
+        let elevated = color(
+            &format!("{name}: elevated_surface.background"),
+            &style.colors.elevated_surface_background,
+        );
+
+        assert!(
+            !same_color(elevated, surface),
+            "{name}: elevated_surface.background must differ from surface.background \
+             (R3.4). Today they are byte-identical, which is why Zed's elevation reads \
+             as flat — research finding 2."
+        );
+
+        let step = (relative_luminance(elevated) - relative_luminance(surface)).abs();
+        assert!(
+            step >= MIN_LUMINANCE_STEP,
+            "{name}: the elevated step is {step:.4} relative luminance — that is not a \
+             step, it is Zed's dead +0.002 by another name. An elevated surface must be \
+             separated by a VISIBLE background step and a hairline, not by a shadow \
+             (R2.1, D7)."
+        );
+
+        let ladder_step =
+            (relative_luminance(surface) - relative_luminance(background)).abs();
+        assert!(
+            ladder_step >= MIN_LUMINANCE_STEP,
+            "{name}: surface.background must also sit a visible step off the canvas \
+             ({ladder_step:.4}) — the ladder is e0 → e1 → e2, and a broken bottom rung \
+             is as flat as a broken top one"
+        );
+    }
+}
+
+/// The top rung (D25). `modal_surface_background` was added by sub-task 3.0 for
+/// exactly one reason: before it, `ElevationIndex::ElevatedSurface` and
+/// `::ModalSurface` both resolved to `elevated_surface_background`, so a
+/// four-level ladder could not be *represented*, never mind rendered.
+///
+/// The field falls back to `elevated_surface.background` when a theme omits it —
+/// a fallback that exists to protect *Zed's* themes, which predate the field. If
+/// Zeo omits it, that fallback silently collapses e3 onto e2 and Zeo ships a
+/// three-level ladder with a green suite. The tests above cannot see this: they
+/// stop at `elevated`. Hence this one.
+#[test]
+fn modal_surface_is_a_real_luminance_step_above_elevated_in_both_variants() {
+    let family = zeo_family();
+
+    for name in ["Zeo Dark", "Zeo Light"] {
+        let style = &variant(&family, name).style;
+
+        assert!(
+            style.colors.modal_surface_background.is_some(),
+            "{name}: modal_surface.background must be SET explicitly. Leaving it \
+             absent is not a neutral choice — it falls back to \
+             elevated_surface.background (theme.rs:548-552), which collapses e3 onto \
+             e2 and ships a three-level ladder silently, with every other test still \
+             green (D25)."
+        );
+
+        let elevated = color(
+            &format!("{name}: elevated_surface.background"),
+            &style.colors.elevated_surface_background,
+        );
+        let modal = color(
+            &format!("{name}: modal_surface.background"),
+            &style.colors.modal_surface_background,
+        );
+
+        assert!(
+            !same_color(modal, elevated),
+            "{name}: modal_surface.background must differ from \
+             elevated_surface.background — setting it to the same colour is the \
+             fallback written out by hand, not a fix"
+        );
+
+        let step = (relative_luminance(modal) - relative_luminance(elevated)).abs();
+        assert!(
+            step >= MIN_LUMINANCE_STEP,
+            "{name}: the modal step is {step:.4} relative luminance and must clear \
+             {MIN_LUMINANCE_STEP} — the same floor every other rung clears. A modal is \
+             the furthest thing from the canvas the app can show; if it does not read \
+             as raised above an elevated surface, the ladder has no top (D7, R2.1)."
+        );
+    }
+}
+
+// --- The contrast floor (R3.5) ------------------------------------------------
+
+#[test]
+fn the_accent_clears_wcag_aa_against_the_editor_background_in_both_variants() {
+    let family = zeo_family();
+
+    for name in ["Zeo Dark", "Zeo Light"] {
+        let style = &variant(&family, name).style;
+
+        let accent = color(&format!("{name}: text.accent"), &style.colors.text_accent);
+        let editor = color(
+            &format!("{name}: editor.background"),
+            &style.colors.editor_background,
+        );
+
+        let ratio = contrast_ratio(accent, editor);
+        assert!(
+            ratio >= AA_CONTRAST,
+            "{name}: the accent scores {ratio:.2}:1 against the editor background and \
+             must clear {AA_CONTRAST}:1 (R3.5). Prism Teal was rejected for exactly this \
+             failure at 3.59:1 — an accent that fails AA is not a candidate, however good \
+             it looks in a mock."
+        );
+    }
+}
+
+// --- Theme-name coherence (R3.6) ---------------------------------------------
+
+/// The single most dangerous silent failure in this story. The theme is keyed by
+/// the `name` field INSIDE the JSON, not by the filename. If the string in
+/// `default.json` does not match it EXACTLY, the app falls back to One Dark and
+/// only logs — after extensions load (`theme_settings.rs:171-181`). That is a Zeo
+/// build that looks exactly like Zed, with a green test suite and a clean build.
+#[test]
+fn default_json_theme_names_match_the_theme_family() {
+    let family = zeo_family();
+    let names: Vec<&str> = family
+        .themes
+        .iter()
+        .map(|theme| theme.name.as_str())
+        .collect();
+
+    let raw = read_asset("settings/default.json");
+    let text = match String::from_utf8(raw) {
+        Ok(text) => text,
+        Err(error) => panic!("assets/settings/default.json is not UTF-8: {error}"),
+    };
+
+    // default.json carries comments and trailing commas, so it needs the same
+    // lenient parser the settings store uses.
+    let settings: serde_json::Value = match serde_json_lenient::from_str(&text) {
+        Ok(value) => value,
+        Err(error) => panic!("assets/settings/default.json does not parse: {error}"),
+    };
+
+    let theme_block = &settings["theme"];
+
+    assert_eq!(
+        theme_block["mode"], "system",
+        "the appearance still follows the system (D11) — 002 changes which themes are \
+         named, not how they are chosen"
+    );
+
+    for (key, expected) in [("dark", "Zeo Dark"), ("light", "Zeo Light")] {
+        let configured = theme_block[key].as_str().unwrap_or("<not a string>");
+
+        assert_eq!(
+            configured, expected,
+            "assets/settings/default.json names {configured:?} for `{key}`, but the theme \
+             is keyed by the `name` field inside zeo.json. A mismatch does NOT fail the \
+             build, does NOT fail the app, and does NOT show an error — it silently falls \
+             back to One Dark (R3.6)."
+        );
+
+        assert!(
+            names.contains(&expected),
+            "{expected:?} must exist as a `name` in zeo.json; it declares {names:?}"
+        );
+    }
+}
